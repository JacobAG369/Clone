# Configuración de URL de la API REST Backend (Django)
# Para desarrollo local:
VITE_API_URL=http://localhost:8000/api/v1
# Para producción en Render (ejemplo):
# VITE_API_URL=https://tu-backend.onrender.com/api/v1

# Clave de API de CARTO Basemaps (obtener gratis en carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=tu_api_key_de_carto_aqui
